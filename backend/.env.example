# === SideQuest backend env ===
# Copy to `.env` and fill in. NEVER commit the real .env.

# App
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Replicate (the mission engine — runs mission_generator.md). Model is any Replicate
# owner/name, e.g. google/gemini-3.5-flash or anthropic/claude-sonnet-5.
# Token: replicate.com/account/api-tokens. Blank => hardcoded fallback deck.
REPLICATE_API_KEY=
REPLICATE_MODEL=google/gemini-3.5-flash

# Gemini (real-place discovery). Optional — leave blank to disable
# (missions still generate without real places).
# Default mode uses Gemini's own knowledge (FREE tier). Live Google Maps
# grounding needs a BILLING-enabled project; set the flag below to true then.


# Admin override account — seeded into the DB on startup (no hardcode in source).
# Leave blank to skip seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Supabase Storage bucket for user-uploaded mission photos
STORAGE_BUCKET=mission-photos
