# === TRIP QUEST backend env ===
# Copy to `.env` and fill in. NEVER commit the real .env.

# App
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic / Claude (the mission engine — creative mission writing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Gemini (real-place discovery via Google Maps grounding). Optional.
# Free tier: ~1500 req/day; Maps grounding ~5000 free prompts/month.
# Leave blank to disable — missions still generate without real places.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
