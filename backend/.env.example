# === TRIP QUEST backend env ===
# Copy to `.env` and fill in. NEVER commit the real .env.

# App
APP_ENV=development
# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic / Claude (the mission engine — creative mission writing)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Gemini (real-place discovery). Optional — leave blank to disable
# (missions still generate without real places).
# Default mode uses Gemini's own knowledge (FREE tier). Live Google Maps
# grounding needs a BILLING-enabled project; set the flag below to true then.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_USE_MAPS_GROUNDING=false
