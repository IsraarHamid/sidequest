# Root compose env — copy to `.env` (gitignored). Only needed for optional bits.

# Host port overrides (see docker-compose.yml)
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# ngrok tunnel (`docker compose --profile tunnel up`)
# Authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# What to expose: backend:8000 (API, default) or frontend:3000 (web app)
NGROK_TARGET=backend:8000
